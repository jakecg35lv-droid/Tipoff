rules_version = '2';

// ════════════════════════════════════════════════════════════
//  TIPOFF FANTASY — Firestore security rules
//
//  Paste these into Firebase Console → Firestore → Rules, or
//  deploy with:  firebase deploy --only firestore:rules
//
//  NOTE: the users/{uid} block is new. Without it the My Leagues
//  list, accent color and account deletion all fail silently,
//  because a denied read looks identical to an empty document.
// ════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Per-user record ──────────────────────────────────────
    //  { displayName, accent, leagues: [{code, name, joinedAt}] }
    //  Readable and writable only by that user. Nobody else has
    //  any business knowing which leagues a person belongs to.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Leagues ──────────────────────────────────────────────
    //  Any signed-in user may read and write a league they know
    //  the code for. The code IS the access control, which is
    //  why codes are random and six characters.
    match /leagues/{leagueCode} {
      allow read, write: if request.auth != null;

      match /{sub=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Season leagues ───────────────────────────────────────
    //  Regular-season mode. One document per league, keyed by the
    //  six-character code, exactly like tournament leagues: the code
    //  is the access control, which is why it is random.
    //
    //  Deliberately a SEPARATE collection from /leagues. Season and
    //  tournament state have different shapes, and a bug in one must
    //  not be able to write over the other.
    match /seasonLeagues/{code} {
      allow read, write: if request.auth != null;

      //  Weekly box scores live here rather than in the parent
      //  document, which would otherwise approach the 1MB ceiling
      //  across a full season. Written by the stats job, read by
      //  clients — so clients must not be able to invent scores.
      match /weeks/{week} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /{sub=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Season box scores ────────────────────────────────────
    //  Written by the syncSeasonStats function with the Admin SDK,
    //  which bypasses these rules. Clients read only — otherwise a
    //  manager could invent his own stat line.
    match /seasonStats/{season} {
      allow read: if request.auth != null;
      allow write: if false;

      match /{sub=**} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ── Content reports ──────────────────────────────────────
    //  Section 9 of the Terms says we act on reports we receive. That
    //  needs a durable record, and the record must be write-only:
    //  a client that could read this collection could enumerate who
    //  reported whom, and a client that could delete from it could
    //  erase the evidence of its own abuse.
    //
    //  create only. No read, no update, no delete, for anyone.
    //  Reviewed through the Firebase console or the Admin SDK, which
    //  bypass these rules.
    match /contentReports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.messageText.size() <= 1000;
      allow read, update, delete: if false;
    }

    // ── Live tournament stats ────────────────────────────────
    //  Written only by the Cloud Function, which uses the Admin
    //  SDK and bypasses these rules entirely. Clients read only.
    match /tournamentStats/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /players/{playerId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // Live game scores and winners, written by the Cloud Function.
      // Clients read these to render live scores and advance brackets.
      match /games/{gameId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ── Function metadata ────────────────────────────────────
    //  meta/activeTournaments is written by the app when a
    //  commissioner picks a tournament, and read by the function.
    //  meta/syncHealth and meta/teamDirectory belong to the
    //  function alone, so clients cannot touch them.
    match /meta/activeTournaments {
      allow read, write: if request.auth != null;
    }
    match /meta/syncHealth {
      allow read, write: if false;
    }
    match /meta/teamDirectory {
      allow read, write: if false;
    }

    // Anything not matched above is denied.
  }
}

rules_version = '2';

// ════════════════════════════════════════════════════════════
//  TIPOFF FANTASY — Firestore security rules
//
//  Paste these into Firebase Console → Firestore → Rules, or
//  deploy with:  firebase deploy --only firestore:rules
//
//  NOTE: the users/{uid} block is new. Without it the My Leagues
//  list, accent color and account deletion all fail silently,
//  because a denied read looks identical to an empty document.
// ════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Per-user record ──────────────────────────────────────
    //  { displayName, accent, leagues: [{code, name, joinedAt}] }
    //  Readable and writable only by that user. Nobody else has
    //  any business knowing which leagues a person belongs to.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      //  ── Web push subscriptions ──────────────────────────────
      //  A rule on users/{uid} does NOT cascade to subcollections,
      //  so without this block every subscribe() write is denied and
      //  push silently never works — savePushSubscription logs a
      //  permission error nobody reads and the toggle looks fine.
      //
      //  Owner-only, and deliberately not readable by anyone else: a
      //  push endpoint plus its two keys is a capability. Whoever
      //  holds them can put a notification on that person's lock
      //  screen, with no further authentication. The sender runs in
      //  Cloud Functions on the Admin SDK, which bypasses rules.
      match /pushSubs/{subId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Push dedupe markers ──────────────────────────────────
    //  Firestore triggers are at-least-once, so the sender claims a
    //  one-shot marker per (league, pick) before notifying. Written
    //  only by the function, via the Admin SDK. Closed to clients:
    //  a client that could create these could pre-claim a pick and
    //  suppress a rival's on-the-clock alert.
    match /pushSent/{key} {
      allow read, write: if false;
    }

    // ── Leagues ──────────────────────────────────────────────
    //  Any signed-in user may read and write a league they know
    //  the code for. The code IS the access control, which is
    //  why codes are random and six characters.
    match /leagues/{leagueCode} {
      allow read, write: if request.auth != null;

      match /{sub=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Season leagues ───────────────────────────────────────
    //  Regular-season mode. One document per league, keyed by the
    //  six-character code, exactly like tournament leagues: the code
    //  is the access control, which is why it is random.
    //
    //  Deliberately a SEPARATE collection from /leagues. Season and
    //  tournament state have different shapes, and a bug in one must
    //  not be able to write over the other.
    match /seasonLeagues/{code} {
      allow read, write: if request.auth != null;

      //  Weekly box scores live here rather than in the parent
      //  document, which would otherwise approach the 1MB ceiling
      //  across a full season. Written by the stats job, read by
      //  clients — so clients must not be able to invent scores.
      //
      //  There used to be a `match /{sub=**}` wildcard below granting
      //  read AND write on every subcollection. Firestore ORs all
      //  matching rules together, so that wildcard silently cancelled
      //  the `write: if false` here: any signed-in user could have
      //  written their own box scores. The wildcard is gone — the
      //  client only ever writes the parent league document, and the
      //  stats job uses the Admin SDK, which bypasses these rules.
      match /weeks/{week} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ── Season box scores ────────────────────────────────────
    //  Written by the syncSeasonStats function with the Admin SDK,
    //  which bypasses these rules. Clients read only — otherwise a
    //  manager could invent his own stat line.
    //  Covers games/, players/ and projections/. All three are
    //  written by Cloud Functions on the Admin SDK, which bypasses
    //  these rules; clients read only. A client that could write
    //  projections could inflate its own draft board, and one that
    //  could write players/ could invent its own stat line.
    match /seasonStats/{season} {
      allow read: if request.auth != null;
      allow write: if false;

      match /{sub=**} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    /*  ── Feedback and bug reports ─────────────────────────────
        Create-only, exactly like contentReports. A client may file a
        report and nothing else: it cannot read other people's
        reports, amend its own, or delete one after the fact.

        Note what is NOT here: the Trigger Email extension's `mail`
        collection. If clients could write there, anyone could send
        arbitrary email from the app's domain — an open relay with
        our name on it. A Cloud Function copies each report across
        with the Admin SDK instead.                               */
    match /feedback/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 1500
                    && request.resource.data.status == 'new'
                    && request.resource.data.kind in ['bug', 'stuck', 'idea'];
      allow read, update, delete: if false;
    }

    /*  Written only by the feedback function, read only by the
        Trigger Email extension, which uses the Admin SDK and
        bypasses these rules. Closed to every client. */
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // ── Content reports ──────────────────────────────────────
    //  Section 9 of the Terms says we act on reports we receive. That
    //  needs a durable record, and the record must be write-only:
    //  a client that could read this collection could enumerate who
    //  reported whom, and a client that could delete from it could
    //  erase the evidence of its own abuse.
    //
    //  create only. No read, no update, no delete, for anyone.
    //  Reviewed through the Firebase console or the Admin SDK, which
    //  bypass these rules.
    match /contentReports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.messageText.size() <= 1000;
      allow read, update, delete: if false;
    }

    // ── Live tournament stats ────────────────────────────────
    //  Written only by the Cloud Function, which uses the Admin
    //  SDK and bypasses these rules entirely. Clients read only.
    match /tournamentStats/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /players/{playerId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // Live game scores and winners, written by the Cloud Function.
      // Clients read these to render live scores and advance brackets.
      match /games/{gameId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ── Function metadata ────────────────────────────────────
    //  meta/activeTournaments is written by the app when a
    //  commissioner picks a tournament, and read by the function.
    //  meta/syncHealth and meta/teamDirectory belong to the
    //  function alone, so clients cannot touch them.
    match /meta/activeTournaments {
      allow read, write: if request.auth != null;
    }
    match /meta/syncHealth {
      allow read, write: if false;
    }
    match /meta/teamDirectory {
      allow read, write: if false;
    }

    // ── Tipoff Trivia: one Daily per signed-in player ─────────
    // Doc id = "{uid}_{YYYY-MM-DD}". Created when the Daily starts; it can be
    // marked finished once, and can never be deleted or reset.
    match /dailyPlays/{playId} {
      allow read: if request.auth != null && playId.matches(request.auth.uid + '_.*');
      allow create: if request.auth != null
        && playId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.finished == false
        && request.resource.data.keys().hasOnly(['uid','date','finished','startedAt']);
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.finished == false
        && request.resource.data.finished == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finished','score','tiers'])
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 700;
      allow delete: if false;
    }

    // ── Tipoff Trivia: one HS Daily per signed-in player (same rules as dailyPlays) ──
    match /hsDailyPlays/{playId} {
      allow read: if request.auth != null && playId.matches(request.auth.uid + '_.*');
      allow create: if request.auth != null
        && playId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.finished == false
        && request.resource.data.keys().hasOnly(['uid', 'date', 'finished', 'startedAt']);
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.finished == false
        && request.resource.data.finished == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finished', 'score', 'tiers'])
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 700;
      allow delete: if false;
    }

    // ── Tipoff Trivia: paid entitlements ─────────────────────
    //  Written ONLY by the stripeWebhook Cloud Function (admin SDK
    //  bypasses rules). Owners can read their own; nobody can write.
    //  Do NOT store this in users/{uid}: users can write that doc.
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /stripeCustomers/{customerId} {
      allow read, write: if false;
    }
    match /stripePayments/{paymentIntentId} {
      allow read, write: if false;
    }

    // Anything not matched above is denied.
  }
}
